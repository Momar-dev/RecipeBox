# ─── Serveur ───────────────────────────────────────────────────────────────────
# Port d'écoute du serveur Express (défaut : 3001)
PORT=3001

# URL de base de l'application frontend (pour CORS en développement)
CLIENT_URL=http://localhost:3000

# ─── Base de données (PostgreSQL + Prisma) ────────────────────────────────────
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Exemples de services cloud gratuits : Neon (neon.tech), Supabase, Railway, Render
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/recipebox?schema=public"

# ─── Authentification JWT ─────────────────────────────────────────────────────
# Clé secrète cryptographique pour signer les jetons JWT (min 32 caractères recommandés)
JWT_SECRET="remplacer_par_une_chaine_aleatoire_longue_et_securisee_min_32_chars"
# Durée de validité des jetons JWT (ex: 7d, 24h, 1h)
JWT_EXPIRES_IN="7d"

# ─── Cloudinary (Upload d'images) ─────────────────────────────────────────────
# Récupérables sur votre console Cloudinary (https://console.cloudinary.com/ -> Dashboard -> Product Environment Credentials)
CLOUDINARY_CLOUD_NAME="votre_cloud_name"
CLOUDINARY_API_KEY="votre_api_key"
CLOUDINARY_API_SECRET="votre_api_secret"
