{
  "name": "recipe-box-server",
  "version": "1.0.0",
  "description": "Recipe Box — Backend Express/TypeScript",
  "private": true,
  "type": "commonjs",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "tsx tests/phase4_auth.test.ts && tsx tests/phase5_upload.test.ts && tsx tests/phase6_frontend_integration.test.ts && tsx tests/phase7_favorites.test.ts",
    "test:auth": "tsx tests/phase4_auth.test.ts",
    "test:upload": "tsx tests/phase5_upload.test.ts",
    "test:integration": "tsx tests/phase6_frontend_integration.test.ts",
    "test:favorites": "tsx tests/phase7_favorites.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
